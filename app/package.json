{
  "name": "undercover-ph-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "demo:record": "pnpm build && node scripts/demo-record.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "maplibre-gl": "5.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
